{
  "name": "angular-schematics",
  "version": "0.0.0",
  "private": true,
  "description": "A collection of Angular schematics, each published to npm under its own name.",
  "author": "Damian Sire",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damiansire/angular-schematics.git"
  },
  "keywords": [
    "angular",
    "schematics",
    "migration",
    "codemod",
    "monorepo"
  ],
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "c8 npm test",
    "pack:check": "node scripts/check-pack.mjs",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run build && npm run pack:check && npm run test:coverage",
    "changeset": "changeset",
    "version": "changeset version",
    "publish:dist": "npm run build --workspaces --if-present && node scripts/publish-dist.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
